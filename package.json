{
  "name": "raffle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "test": "pnpm --filter app test",
    "test:e2e": "pnpm --filter app test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter app typecheck && pnpm --filter @raffle/shared typecheck",
    "db:migrate": "pnpm --filter @raffle/shared db:migrate",
    "db:generate": "pnpm --filter @raffle/shared db:generate",
    "db:studio": "pnpm --filter @raffle/shared db:studio",
    "db:seed": "pnpm db:migrate && bun run scripts/seed.ts",
    "db:migrate:mysql": "bun run scripts/migrate-mysql-to-libsql.ts",
    "db:repair:payment-accounts": "bun run scripts/repair-payment-accounts.ts",
    "db:validate:migration": "bun run scripts/validate-migration.ts",
    "env:sync-email": "bun run scripts/sync-email-env.ts",
    "deploy:yoiberifas": "bash deploy/vps-yoiberifas-full.sh",
    "deploy:fast": "bash deploy/vps-fast-deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@libsql/client": "^0.15.15",
    "@raffle/shared": "workspace:*",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.1"
}
