{
  "name": "raffle",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "test": "pnpm --filter app test",
    "test:e2e": "pnpm --filter app test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter app typecheck && pnpm --filter @raffle/shared typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bcryptjs": "^3.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.22.3"
  }
}
