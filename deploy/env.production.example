# Copiar a /opt/raffle/.env en el VPS
# chmod 600 /opt/raffle/.env

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── URLs públicas (deben coincidir con nginx + certificado SSL) ───
APP_URL=https://tudominio.com
BETTER_AUTH_URL=https://tudominio.com

# ─── SQLite en disco (mismo VPS) ───────────────────────────────────
DATABASE_URL=file:/opt/raffle/data/raffle.db

# Turso remoto (opcional, en lugar de file:):
# DATABASE_URL=libsql://tu-db.turso.io
# DATABASE_AUTH_TOKEN=

# ─── Auth ──────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=genera-un-string-aleatorio-de-al-menos-32-caracteres

# ─── Uploads (copiar carpeta legacy aquí) ──────────────────────────
UPLOAD_DIR=/opt/raffle/uploads

# ─── Email ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=

# ─── Cron mantenimiento (cada 5 min vía crontab) ───────────────────
CRON_SECRET=otro-secreto-largo-aleatorio

# ─── Migración one-time (solo para vps-cutover.sh) ─────────────────
SOURCE_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/raffle_db
TARGET_DATABASE_URL=file:/opt/raffle/data/raffle.db
MIGRATE_ADMIN_PASSWORD=CambiarDespuesDelCutover123!
