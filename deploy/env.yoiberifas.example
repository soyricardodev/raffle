# yoiberifas.com — copiar a /home/admin/raffle/.env
# chmod 600 /home/admin/raffle/.env

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

APP_URL=https://yoiberifas.com
BETTER_AUTH_URL=https://yoiberifas.com

# SQLite (nuevo, separado del MySQL legacy)
DATABASE_URL=file:/home/admin/raffle/data/raffle.db

BETTER_AUTH_SECRET=CAMBIA-esto-por-un-string-aleatorio-de-al-menos-32-caracteres

# Reutiliza uploads del legacy — las URLs /uploads/... en la DB siguen válidas
UPLOAD_DIR=/home/admin/raffle-app/backend/uploads

EMAIL_PROVIDER=resend
RESEND_API_KEY=

CRON_SECRET=otro-secreto-largo-aleatorio

# ─── Solo para cutover (MySQL legacy → SQLite) ─────────────────────
# Ajusta user/pass según tu backend legacy (.env o config MySQL)
SOURCE_DATABASE_URL=mysql://root:TU_PASSWORD@127.0.0.1:3306/raffle_db
TARGET_DATABASE_URL=file:/home/admin/raffle/data/raffle.db
MIGRATE_ADMIN_PASSWORD=CambiarDespuesDelCutover123!
