# IDE / local
.cursor/
.env
.env.*
!.env.example

# Deploy runtime artifacts (git-clone-as-deploy-root)
# El clone del VPS vive en la misma carpeta que estos directorios. Ninguno
# debe versionarse jamás: `releases/` trae binarios, `data/` la base con PII,
# `secrets/` claves privadas (DKIM) y `logs/` el puntero de rollback.
secrets/
releases/
current
data/
logs/
backups/
.work_*/

# Dependencies
node_modules/

# Build / cache
dist/
.output/
.tanstack/
.nitro/

# OS
.DS_Store
Thumbs.db

# libSQL local files
packages/shared/data/*.db
packages/shared/data/*.db-*

# Dev/test SQLite and uploaded media
test-raffle.db*
app/test-raffle.db*
packages/shared/test-raffle.db*
app/uploads/

# Generated exports (PII — do not commit)
exports/

# Logs
*.log
build-output.txt
app/build-output.txt

# Playwright (app)
app/test-results/
app/playwright-report/
app/blob-report/
app/e2e/.auth/
