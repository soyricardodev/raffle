# Copiar a app/.env para desarrollo local
# Documentación: docs/LIBSQL_CUTOVER_RUNBOOK.md

# ─── Core (libSQL) ──────────────────────────────────────────
# Local: archivo SQLite (ruta relativa desde app/)
DATABASE_URL=file:../packages/shared/data/raffle.db
# Turso remoto (opcional):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

NODE_ENV=development
LOG_LEVEL=info

# ─── Auth (Better Auth) ─────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Uploads ────────────────────────────────────────────────
# Directorio local para comprobantes de pago (servidos en /uploads/payments/*).
# En producción, montar un volumen persistente en esta ruta (relativa a app/).
UPLOAD_DIR=./uploads

# ─── Email ──────────────────────────────────────────────────
# Copiar credenciales y remitente desde legacy: pnpm env:sync-email
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
BREVO_API_KEY=
RESEND_API_KEY=

# ─── Soporte ────────────────────────────────────────────────
# false por defecto. true reactiva WhatsApp como canal de soporte.
ENABLE_WHATSAPP=false

# ─── Cron / mantenimiento ───────────────────────────────────
CRON_SECRET=

# ─── Inngest (opcional) ─────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── PWA / Web Push ─────────────────────────────────────────
# Generar claves: pnpm --filter app pwa:vapid
# Sin estas claves, la instalación PWA funciona pero no se envían avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:soporte@tudominio.com  o  https://tudominio.com
VAPID_SUBJECT=

# ─── Migración MySQL → libSQL (solo scripts) ───────────────
SOURCE_DATABASE_URL=mysql://user:password@localhost:3306/raffle_legacy
TARGET_DATABASE_URL=file:../packages/shared/data/raffle.db
MIGRATE_ADMIN_PASSWORD=ChangeMeAfterCutover!

# ─── Seed desarrollo ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@rifas.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
# SEED_FORCE=1

# ─── E2E Playwright ─────────────────────────────────────────
E2E_PORT=3100
E2E_BASE_URL=http://localhost:3100
E2E_ADMIN_EMAIL=admin@rifas.com
E2E_ADMIN_PASSWORD=admin123
E2E_REUSE_SERVER=0
