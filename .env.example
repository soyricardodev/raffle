# Copiar a app/.env para desarrollo local (o configurar en el host de producción)
# Documentación: docs/RUNBOOK.md

# ─── Core ───────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/raffle_db
NODE_ENV=development
LOG_LEVEL=info

# ─── Auth (Better Auth) ─────────────────────────────────────
# Producción: generar secreto aleatorio ≥ 32 caracteres
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Uploads ────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Email ──────────────────────────────────────────────────
# noop | brevo | resend
EMAIL_PROVIDER=noop
BREVO_API_KEY=
RESEND_API_KEY=

# ─── Cron / mantenimiento ───────────────────────────────────
# Header x-cron-secret en POST /api/cron/maintenance
CRON_SECRET=

# ─── Inngest (opcional; alternativa al cron HTTP) ─────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Migración legacy (solo script migrate-from-legacy.ts) ──
LEGACY_DATABASE_URL=
NEW_DATABASE_URL=

# ─── E2E Playwright (local / CI) ────────────────────────────
# Ver docs/E2E.md
E2E_PORT=3100
E2E_BASE_URL=http://localhost:3100
E2E_ADMIN_EMAIL=admin@rifas.com
E2E_ADMIN_PASSWORD=admin123
E2E_REUSE_SERVER=0
